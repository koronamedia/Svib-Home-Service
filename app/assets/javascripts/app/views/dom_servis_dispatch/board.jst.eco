<div class="dom-servis-dispatch-board__shell">
  <div class="dom-servis-dispatch-board__hero">
    <div class="dom-servis-dispatch-board__hero-copy">
      <div class="dom-servis-dispatch-board__eyebrow">Р”РѕРј-РЎРµСЂРІРёСЃ</div>
      <h1>Р”РёСЃРїРµС‚С‡РµСЂРёР·Р°С†РёСЏ Р·Р°СЏРІРѕРє</h1>
      <p>Р“Р»Р°РІРЅРѕРµ СЂР°Р±РѕС‡РµРµ РїРѕР»Рµ РґР»СЏ РїСѓР±Р»РёРєР°С†РёРё Р·Р°СЏРІРѕРє РІ РѕР±С‰РёР№ РїСѓР», Р·Р°С…РІР°С‚Р° РјР°СЃС‚РµСЂР°РјРё Рё РµР¶РµРґРЅРµРІРЅРѕРіРѕ РєРѕРЅС‚СЂРѕР»СЏ РїРѕ РґРЅСЏРј РЅРµРґРµР»Рё.</p>
    </div>
    <div class="dom-servis-dispatch-board__hero-side">
      <% if @currentUserCard: %>
        <div class="dom-servis-dispatch-board__user-card">
          <div class="dom-servis-dispatch-board__user-avatar"><%= @currentUserCard.initials %></div>
          <div class="dom-servis-dispatch-board__user-body">
            <div class="dom-servis-dispatch-board__user-name"><%= @currentUserCard.name %></div>
            <div class="dom-servis-dispatch-board__user-meta"><%= @currentUserCard.email %></div>
            <div class="dom-servis-dispatch-board__user-meta"><%= @currentUserCard.phone %></div>
            <div class="dom-servis-dispatch-board__user-meta"><%= @currentUserCard.organization %></div>
          </div>
        </div>
      <% end %>
      <div class="dom-servis-dispatch-board__role"><span>Р РѕР»СЊ</span><strong><%= @roleLabel %></strong></div>
      <div class="dom-servis-dispatch-board__header-actions">
        <button class="btn js-refresh-jobs">РћР±РЅРѕРІРёС‚СЊ</button>
        <% if @canCreateJob: %>
          <button class="btn btn--success js-open-create">РќРѕРІР°СЏ Р·Р°СЏРІРєР°</button>
        <% end %>
      </div>
    </div>
  </div>

  <% if @error: %>
    <div class="alert alert-danger dom-servis-dispatch-board__alert"><%= @error %></div>
  <% end %>

  <div class="dom-servis-dispatch-board__stats">
    <div class="dom-servis-dispatch-stat">
      <span class="dom-servis-dispatch-stat__label">Р’СЃРµРіРѕ</span>
      <strong class="dom-servis-dispatch-stat__value"><%= @stats.total %></strong>
    </div>
    <div class="dom-servis-dispatch-stat">
      <span class="dom-servis-dispatch-stat__label">Р’ РїСѓР»Рµ</span>
      <strong class="dom-servis-dispatch-stat__value"><%= @stats.pool %></strong>
    </div>
    <div class="dom-servis-dispatch-stat">
      <span class="dom-servis-dispatch-stat__label">Р’ СЂР°Р±РѕС‚Рµ</span>
      <strong class="dom-servis-dispatch-stat__value"><%= @stats.active %></strong>
    </div>
    <div class="dom-servis-dispatch-stat">
      <span class="dom-servis-dispatch-stat__label">РњРѕРё</span>
      <strong class="dom-servis-dispatch-stat__value"><%= @stats.mine %></strong>
    </div>
    <div class="dom-servis-dispatch-stat">
      <span class="dom-servis-dispatch-stat__label">Р“РѕС‚РѕРІРѕ</span>
      <strong class="dom-servis-dispatch-stat__value"><%= @stats.done %></strong>
    </div>
    <div class="dom-servis-dispatch-stat">
      <span class="dom-servis-dispatch-stat__label">РќР° СЃРµРіРѕРґРЅСЏ</span>
      <strong class="dom-servis-dispatch-stat__value"><%= @stats.today %></strong>
    </div>
  </div>

  <div class="dom-servis-dispatch-board__control-block">
    <div class="dom-servis-dispatch-board__control-label">РЎСЂРµР· РїРѕ СЃРѕСЃС‚РѕСЏРЅРёСЋ</div>
    <div class="dom-servis-dispatch-board__filters">
      <% for item in @statusFilters: %>
        <button class="btn btn--text js-status-filter<%= ' is-active' if item.active %>" data-filter="<%= item.id %>">
          <span><%= item.label %></span>
          <strong><%= item.count %></strong>
        </button>
      <% end %>
    </div>
  </div>

  <div class="dom-servis-dispatch-board__control-block">
    <div class="dom-servis-dispatch-board__control-label">Р”РЅРё РЅРµРґРµР»Рё</div>
    <div class="dom-servis-dispatch-board__week-bar">
      <div class="dom-servis-dispatch-board__week-actions">
        <button class="btn btn--text js-week-shift" data-offset="-1">в†ђ РџСЂРѕС€Р»Р°СЏ</button>
        <button class="btn btn--text js-week-reset<%= ' is-active' if @weekControls.isCurrent %>">РўРµРєСѓС‰Р°СЏ</button>
        <button class="btn btn--text js-week-shift" data-offset="1">РЎР»РµРґСѓСЋС‰Р°СЏ в†’</button>
      </div>
      <div class="dom-servis-dispatch-board__week-summary">
        <strong><%= @weekControls.startLabel %> - <%= @weekControls.endLabel %></strong>
        <input class="form-control js-week-picker" type="date" value="<%= @weekControls.pickerValue %>">
      </div>
    </div>
    <div class="dom-servis-dispatch-board__day-filters">
      <% for item in @dayFilters: %>
        <button class="btn btn--text js-day-filter<%= ' is-active' if item.active %>" data-filter="<%= item.id %>">
          <span><%= item.shortLabel || item.label %></span>
          <strong><%= item.count %></strong>
        </button>
      <% end %>
    </div>
  </div>

  <% if @tagFilters.length > 0: %>
    <div class="dom-servis-dispatch-board__control-block">
      <div class="dom-servis-dispatch-board__control-label">Р СћР ВµР С–Р С‘</div>
      <div class="dom-servis-dispatch-board__filters dom-servis-dispatch-board__filters--tags">
        <% for item in @tagFilters: %>
          <button class="btn btn--text js-tag-filter-toggle<%= ' is-active' if item.active %>" data-tag="<%= item.id %>">
            <span><%= item.label %></span>
            <strong><%= item.count %></strong>
          </button>
        <% end %>
        <% if _.some(@tagFilters, (item) -> item.active): %>
          <button class="btn btn--text js-clear-tag-filters">Р РЋР В±РЎР‚Р С•РЎРѓР С‘РЎвЂљРЎРЉ</button>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @loading: %>
    <div class="dom-servis-dispatch-board__empty">
      <div class="spinner spinner--small"></div>
      <span>Р—Р°РіСЂСѓР·РєР° Р·Р°СЏРІРѕРє...</span>
    </div>
  <% else if @jobCards.length is 0: %>
    <div class="dom-servis-dispatch-board__empty">
      <strong>РџРѕ С‚РµРєСѓС‰РµРјСѓ СЃСЂРµР·Сѓ Р·Р°СЏРІРѕРє РЅРµС‚.</strong>
      <span>РЎРјРµРЅРё РЅРµРґРµР»СЋ РёР»Рё С„РёР»СЊС‚СЂ, Р»РёР±Рѕ СЃРѕР·РґР°Р№ РїРµСЂРІСѓСЋ Р·Р°СЏРІРєСѓ РІ РїСѓР».</span>
    </div>
  <% else: %>
    <div class="dom-servis-dispatch-board__grid">
      <% for job in @jobCards: %>
        <article class="dom-servis-dispatch-card dom-servis-dispatch-card--<%= job.status %> dom-servis-dispatch-card--<%= job.priority %> js-job-card" data-id="<%= job.id %>">
          <div class="dom-servis-dispatch-card__topline">
            <div class="dom-servis-dispatch-card__identity">
              <span class="dom-servis-dispatch-card__code"><%= job.jobCode %></span>
              <span class="dom-servis-dispatch-card__day"><%= job.visitDayLabel %></span>
            </div>
            <span class="dom-servis-dispatch-card__status dom-servis-dispatch-card__status--<%= job.status %>"><%= job.statusLabel %></span>
          </div>

          <div class="dom-servis-dispatch-card__title"><%= job.serviceType %></div>
          <div class="dom-servis-dispatch-card__address"><%= job.address %></div>

          <div class="dom-servis-dispatch-card__meta">
            <span><%= job.scheduleLabel %></span>
            <span><%= job.assigneeName %></span>
          </div>

          <div class="dom-servis-dispatch-card__contact">
            <span><%= job.clientName %></span>
            <% if job.clientPhone: %>
              <span><%= job.clientPhone %></span>
            <% end %>
          </div>

          <div class="dom-servis-dispatch-card__badge-row">
            <span class="dom-servis-dispatch-card__priority dom-servis-dispatch-card__priority--<%= job.priority %>"><%= job.priorityLabel %></span>
            <% for tag in job.visibleTags: %>
              <button class="dom-servis-dispatch-card__tag js-no-detail js-tag-filter-toggle<%= ' is-active' if tag.active %>" data-tag="<%= tag.name %>"><%= tag.name %></button>
            <% end %>
            <% if job.moreTagsCount > 0: %>
              <span class="dom-servis-dispatch-card__tag">+<%= job.moreTagsCount %></span>
            <% end %>
          </div>

          <% if job.summaryText: %>
            <div class="dom-servis-dispatch-card__summary"><%= job.summaryText %></div>
          <% end %>

        </article>
      <% end %>
    </div>
  <% end %>

  <% if @detailOpen && @detailJob: %>
    <div class="dom-servis-dispatch-drawer">
      <div class="dom-servis-dispatch-drawer__backdrop js-close-detail"></div>
      <aside class="dom-servis-dispatch-drawer__panel">
        <div class="dom-servis-dispatch-drawer__header">
          <div class="dom-servis-dispatch-drawer__headline">
            <div class="dom-servis-dispatch-drawer__code"><%= @detailJob.jobCode %></div>
            <h2><%= @detailJob.title %></h2>
            <div class="dom-servis-dispatch-drawer__status-row">
              <span class="dom-servis-dispatch-card__status dom-servis-dispatch-card__status--<%= @detailJob.statusClass %>"><%= @detailJob.statusLabel %></span>
              <span class="dom-servis-dispatch-card__priority dom-servis-dispatch-card__priority--<%= @detailJob.priority %>"><%= @detailJob.priorityLabel %></span>
            </div>
          </div>
          <button class="btn btn--text js-close-detail">Р—Р°РєСЂС‹С‚СЊ</button>
        </div>

        <% if @detailJob.visibleTags.length > 0 || @detailJob.hiddenTagsCount > 0: %>
          <div class="dom-servis-dispatch-drawer__tags">
            <% for tag in @detailJob.visibleTags: %>
              <button class="dom-servis-dispatch-card__tag js-tag-filter-toggle<%= ' is-active' if tag.active %>" data-tag="<%= tag.name %>"><%= tag.name %></button>
            <% end %>
            <% if @detailJob.hiddenTagsCount > 0: %>
              <span class="dom-servis-dispatch-card__tag">+<%= @detailJob.hiddenTagsCount %></span>
            <% end %>
          </div>
        <% end %>

        <div class="dom-servis-dispatch-drawer__body">
          <% if @detailEditing: %>
            <div class="dom-servis-dispatch-drawer__edit-summary">
              <div class="dom-servis-dispatch-drawer__edit-summary-item">
                <span>РЎС‚Р°С‚СѓСЃ</span>
                <strong><%= @detailJob.statusLabel %></strong>
              </div>
              <div class="dom-servis-dispatch-drawer__edit-summary-item">
                <span>РџСЂРёРѕСЂРёС‚РµС‚</span>
                <strong><%= @detailJob.priorityLabel %></strong>
              </div>
              <div class="dom-servis-dispatch-drawer__edit-summary-item dom-servis-dispatch-drawer__edit-summary-item--wide">
                <span>РСЃРїРѕР»РЅРёС‚РµР»СЊ</span>
                <strong><%= @detailJob.assigneeName %></strong>
              </div>
            </div>

            <% for group in @detailEditGroups: %>
              <section class="dom-servis-dispatch-drawer__section">
                <div class="dom-servis-dispatch-drawer__section-title"><%= group.label %></div>
                <div class="dom-servis-dispatch-drawer__form-grid">
                  <% for field in group.items: %>
                    <div class="form-group dom-servis-dispatch-drawer__field<%= ' dom-servis-dispatch-drawer__field--wide' if field.wide %>">
                      <label><%= field.label %></label>

                      <% if field.type is 'textarea': %>
                        <textarea class="form-control js-edit-field" data-field="<%= field.key %>" rows="4"><%= field.value %></textarea>
                      <% else if field.type is 'tag_selector': %>
                        <div class="dom-servis-dispatch-tag-selector">
                          <input class="js-edit-field" data-field="<%= field.key %>" type="hidden" value="<%= field.value %>">
                          <% if field.options.length > 0: %>
                            <div class="dom-servis-dispatch-tag-selector__chips">
                              <% for option in field.options: %>
                                <button class="dom-servis-dispatch-tag-selector__chip js-tag-toggle-chip js-edit-tag-toggle<%= ' is-active' if option.selected %>" data-tag="<%= option.id %>"><%= option.label %></button>
                              <% end %>
                            </div>
                          <% else: %>
                            <div class="dom-servis-dispatch-tag-selector__empty">Р СћР ВµР С–Р С‘ Р С—Р С•Р С”Р В° Р Р…Р Вµ РЎРѓР С•Р В·Р Т‘Р В°Р Р…РЎвЂ№. Р ВРЎвЂ¦ Р Т‘Р С•Р В±Р В°Р Р†Р В»РЎРЏР ВµРЎвЂљ Р В°Р Т‘Р СР С‘Р Р… Р Р† Dispatch Admin Р С‘Р В»Р С‘ Manage &gt; Tags.</div>
                          <% end %>
                        </div>
                      <% else if field.type in ['select', 'user_select', 'organization_select']: %>
                        <select class="form-control js-edit-field" data-field="<%= field.key %>">
                          <% for option in field.options: %>
                            <option value="<%= option.id %>"<%= ' selected' if "#{field.value}" is "#{option.id}" %>><%= option.label %></option>
                          <% end %>
                        </select>
                      <% else if field.type is 'date': %>
                        <input class="form-control js-edit-field" data-field="<%= field.key %>" type="date" value="<%= field.value %>">
                      <% else if field.type is 'time': %>
                        <input class="form-control js-edit-field" data-field="<%= field.key %>" type="time" value="<%= field.value %>">
                      <% else: %>
                        <input class="form-control js-edit-field" data-field="<%= field.key %>" type="text" value="<%= field.value %>">
                      <% end %>

                      <% if field.hint: %>
                        <div class="dom-servis-dispatch-drawer__field-hint"><%= field.hint %></div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </section>
            <% end %>
          <% else: %>
            <% for group in @detailGroups: %>
              <section class="dom-servis-dispatch-drawer__section">
                <div class="dom-servis-dispatch-drawer__section-title"><%= group.label %></div>
                <div class="dom-servis-dispatch-drawer__grid">
                  <% for item, itemIndex in group.items: %>
                    <% displayLabel = item.label %>
                    <% if group.id is 'job': %>
                      <% displayLabel = ['РђРґСЂРµСЃ', 'Р”Р°С‚Р° РІРёР·РёС‚Р°', 'Р’СЂРµРјСЏ РІРёР·РёС‚Р°', 'Р”РµРЅСЊ РЅРµРґРµР»Рё', 'РЎС‚Р°С‚СѓСЃ', 'РџСЂРёРѕСЂРёС‚РµС‚', 'РСЃРїРѕР»РЅРёС‚РµР»СЊ'][itemIndex] || displayLabel %>
                    <% else if group.id is 'client': %>
                      <% displayLabel = ['РРјСЏ', 'РўРµР»РµС„РѕРЅ', 'Р—Р°РєР°Р·С‡РёРє'][itemIndex] || displayLabel %>
                    <% else if group.id is 'content': %>
                      <% displayLabel = ['РўРёРї СЂР°Р±РѕС‚', 'РўРµРіРё', 'РћРїРёСЃР°РЅРёРµ', 'РљРѕРјРјРµРЅС‚Р°СЂРёР№ РґРёСЃРїРµС‚С‡РµСЂР°'][itemIndex] || displayLabel %>
                    <% else if group.id is 'meta': %>
                      <% displayLabel = ['РљРѕРґ Р·Р°СЏРІРєРё', 'РСЃС‚РѕС‡РЅРёРє', 'Backing Ticket'][itemIndex] || displayLabel %>
                    <% end %>
                    <div class="dom-servis-dispatch-drawer__item<%= ' dom-servis-dispatch-drawer__item--wide' if item.wide %>">
                      <div class="dom-servis-dispatch-drawer__item-label"><%= displayLabel %></div>
                      <div class="dom-servis-dispatch-drawer__item-value"><%= item.value %></div>
                    </div>
                  <% end %>
                </div>
              </section>
            <% end %>
          <% end %>

          <section class="dom-servis-dispatch-drawer__section">
            <div class="dom-servis-dispatch-drawer__section-title">Р’Р»РѕР¶РµРЅРёСЏ</div>

            <% if @detailCanAddAttachment: %>
              <div class="dom-servis-dispatch-drawer__attachment-toolbar">
                <select class="form-control js-attachment-kind" data-id="<%= @detailJob.id %>">
                  <% for kind in @detailAttachmentKinds: %>
                    <option value="<%= kind.id %>"><%= kind.label %></option>
                  <% end %>
                </select>
                <input class="js-upload-attachment-input" data-id="<%= @detailJob.id %>" type="file" hidden>
                <button class="btn btn--text js-trigger-attachment-upload" data-id="<%= @detailJob.id %>"<%= ' disabled' if @detailAttachmentUploading %>>
                  <%= 'Р—Р°РіСЂСѓР·РєР°вЂ¦' if @detailAttachmentUploading %>
                  <%= 'Р”РѕР±Р°РІРёС‚СЊ РІР»РѕР¶РµРЅРёРµ' if !@detailAttachmentUploading %>
                </button>
              </div>
            <% end %>

            <% if @detailAttachmentLoading: %>
              <div class="dom-servis-dispatch-drawer__attachment-empty">Р—Р°РіСЂСѓР·РєР° РІР»РѕР¶РµРЅРёР№вЂ¦</div>
            <% else if @detailAttachments.length < 1: %>
              <div class="dom-servis-dispatch-drawer__attachment-empty">Р’Р»РѕР¶РµРЅРёР№ РїРѕРєР° РЅРµС‚.</div>
            <% else: %>
              <div class="dom-servis-dispatch-drawer__attachment-list">
                <% for attachment in @detailAttachments: %>
                  <div class="dom-servis-dispatch-drawer__attachment-item">
                    <div class="dom-servis-dispatch-drawer__attachment-main">
                      <div class="dom-servis-dispatch-drawer__attachment-name"><%= attachment.filename %></div>
                      <div class="dom-servis-dispatch-drawer__attachment-meta">
                        <span><%= attachment.kind_label %></span>
                        <span><%= attachment.created_by_name || 'РќРµРёР·РІРµСЃС‚РЅС‹Р№ РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ' %></span>
                        <span><%= attachment.size %> B</span>
                      </div>
                    </div>
                    <div class="dom-servis-dispatch-drawer__attachment-actions">
                      <% if attachment.preview_url: %>
                        <a class="btn btn--text" href="<%= attachment.preview_url %>" target="_blank" rel="noopener">РџСЂРѕСЃРјРѕС‚СЂ</a>
                      <% end %>
                      <a class="btn btn--text" href="<%= attachment.download_url %>" target="_blank" rel="noopener">РЎРєР°С‡Р°С‚СЊ</a>
                      <% if attachment.can_delete && @detailCanDeleteAttachments: %>
                        <button class="btn btn--danger js-remove-attachment" data-job-id="<%= @detailJob.id %>" data-attachment-id="<%= attachment.id %>">РЈРґР°Р»РёС‚СЊ</button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </section>
        </div>

        <div class="dom-servis-dispatch-drawer__footer">
          <div class="dom-servis-dispatch-card__actions">
            <% if @detailEditing: %>
              <button class="btn js-close-edit">РћС‚РјРµРЅР°</button>
              <button class="btn btn--success js-save-edit"<%= ' disabled' if @editSaving %>>РЎРѕС…СЂР°РЅРёС‚СЊ</button>
            <% else if @detailJob.canEdit || @detailJob.canTake || @detailJob.canStart || @detailJob.canFinish || @detailJob.canRelease || @detailJob.canCancel: %>
              <% if @detailJob.canEdit: %>
                <button class="btn btn--text js-open-edit js-no-detail" data-id="<%= @detailJob.id %>">Р РµРґР°РєС‚РёСЂРѕРІР°С‚СЊ</button>
              <% end %>
              <% if @detailJob.canTake: %>
                <button class="btn btn--success js-take-job js-no-detail" data-id="<%= @detailJob.id %>">Р’Р·СЏС‚СЊ</button>
              <% end %>
              <% if @detailJob.canStart: %>
                <button class="btn btn--primary js-set-status js-no-detail" data-id="<%= @detailJob.id %>" data-status="in_progress">Р’ СЂР°Р±РѕС‚Сѓ</button>
              <% end %>
              <% if @detailJob.canFinish: %>
                <button class="btn btn--success js-set-status js-no-detail" data-id="<%= @detailJob.id %>" data-status="done">Р“РѕС‚РѕРІРѕ</button>
              <% end %>
              <% if @detailJob.canRelease: %>
                <button class="btn js-release-job js-no-detail" data-id="<%= @detailJob.id %>">Р’ РїСѓР»</button>
              <% end %>
              <% if @detailJob.canCancel: %>
                <button class="btn btn--danger js-set-status js-no-detail" data-id="<%= @detailJob.id %>" data-status="cancelled">РћС‚РјРµРЅР°</button>
              <% end %>
            <% end %>
          </div>
        </div>
      </aside>
    </div>
  <% end %>

  <% if @createOpen: %>
    <div class="dom-servis-dispatch-modal">
      <div class="dom-servis-dispatch-modal__backdrop js-close-create"></div>
      <div class="dom-servis-dispatch-modal__dialog">
        <div class="dom-servis-dispatch-modal__header">
          <div>
            <h2>РќРѕРІР°СЏ Р·Р°СЏРІРєР°</h2>
            <p>РџРѕСЃР»Рµ СЃРѕС…СЂР°РЅРµРЅРёСЏ Р·Р°СЏРІРєР° СЃСЂР°Р·Сѓ РїРѕРїР°РґС‘С‚ РІ РѕР±С‰РёР№ РїСѓР» РјР°СЃС‚РµСЂРѕРІ.</p>
          </div>
          <button class="btn btn--text js-close-create">Р—Р°РєСЂС‹С‚СЊ</button>
        </div>

        <div class="dom-servis-dispatch-modal__body">
        <div class="form-group">
          <label>РўРёРї СЂР°Р±РѕС‚ *</label>
          <input class="form-control js-create-service-type js-create-draft-field" type="text" placeholder="РќР°РїСЂРёРјРµСЂ: Р—Р°РјРµРЅР° СЃРјРµСЃРёС‚РµР»СЏ" value="<%= @createDraft.service_type %>">
        </div>

        <div class="form-group">
          <label>РђРґСЂРµСЃ *</label>
          <input class="form-control js-create-address js-create-draft-field" type="text" placeholder="РЈР»РёС†Р°, РґРѕРј, РєРІР°СЂС‚РёСЂР°" value="<%= @createDraft.address %>">
        </div>

          <div class="dom-servis-dispatch-modal__columns">
          <div class="form-group">
            <label>РРјСЏ РєР»РёРµРЅС‚Р°</label>
            <input class="form-control js-create-client-name js-create-draft-field" type="text" placeholder="РњР°СЂРёСЏ" value="<%= @createDraft.client_name %>">
          </div>

          <div class="form-group">
            <label>РўРµР»РµС„РѕРЅ *</label>
            <input class="form-control js-create-client-phone js-create-draft-field" type="text" placeholder="+7 900 000 00 00" value="<%= @createDraft.client_phone %>">
          </div>
        </div>

          <div class="dom-servis-dispatch-modal__columns">
          <div class="form-group">
            <label>Р”РµРЅСЊ РЅРµРґРµР»Рё *</label>
            <select class="form-control js-create-visit-day js-create-draft-field">
              <% for day in [{ id: 'mon', label: 'РџРЅ' }, { id: 'tue', label: 'Р’С‚' }, { id: 'wed', label: 'РЎСЂ' }, { id: 'thu', label: 'Р§С‚' }, { id: 'fri', label: 'РџС‚' }, { id: 'sat', label: 'РЎР±' }, { id: 'sun', label: 'Р’СЃ' }]: %>
                <option value="<%= day.id %>"<%= ' selected' if @createDraft.visit_day is day.id %>><%= day.label %></option>
              <% end %>
            </select>
          </div>

          <div class="form-group">
            <label>Р”Р°С‚Р° РІРёР·РёС‚Р°</label>
            <input class="form-control js-create-visit-date js-create-draft-field" type="date" value="<%= @createDraft.visit_date %>">
          </div>
        </div>

          <div class="dom-servis-dispatch-modal__columns">
          <div class="form-group">
            <label>Р’СЂРµРјСЏ РІРёР·РёС‚Р°</label>
            <input class="form-control js-create-visit-time js-create-draft-field" type="time" value="<%= @createDraft.visit_time %>">
          </div>

          <div class="form-group">
            <label>РџСЂРёРѕСЂРёС‚РµС‚</label>
            <select class="form-control js-create-priority js-create-draft-field">
              <option value="low"<%= ' selected' if @createDraft.priority is 'low' %>>РќРёР·РєРёР№</option>
              <option value="medium"<%= ' selected' if @createDraft.priority is 'medium' %>>РЎСЂРµРґРЅРёР№</option>
              <option value="high"<%= ' selected' if @createDraft.priority is 'high' %>>Р’С‹СЃРѕРєРёР№</option>
              <option value="critical"<%= ' selected' if @createDraft.priority is 'critical' %>>РљСЂРёС‚РёС‡РЅС‹Р№</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Р—Р°РєР°Р·С‡РёРє</label>
          <select class="form-control js-create-organization-id js-create-draft-field">
            <% for organization in @organizationOptions: %>
              <option value="<%= organization.id %>"<%= ' selected' if "#{@createDraft.organization_id}" is "#{organization.id}" %>><%= organization.label %></option>
            <% end %>
          </select>
        </div>

        <div class="form-group">
          <label>РўРµРіРё СЂР°Р±РѕС‚</label>
          <div class="dom-servis-dispatch-tag-selector">
            <input class="js-create-work-tags js-create-draft-field" type="hidden" value="<%= @createDraft.work_tags %>">
            <% if @createTagOptions.length > 0: %>
              <div class="dom-servis-dispatch-tag-selector__chips">
                <% for option in @createTagOptions: %>
                  <button class="dom-servis-dispatch-tag-selector__chip js-tag-toggle-chip js-create-tag-toggle<%= ' is-active' if option.selected %>" data-tag="<%= option.id %>"><%= option.label %></button>
                <% end %>
              </div>
            <% else: %>
              <div class="dom-servis-dispatch-tag-selector__empty">Теги пока не созданы. Новые имена добавляются через Manage &gt; Tags.</div>
            <% end %>
          </div>
        </div>

        <div class="form-group">
          <label>РћРїРёСЃР°РЅРёРµ Р·Р°РґР°С‡Рё</label>
          <textarea class="form-control js-create-description js-create-draft-field" rows="4" placeholder="Р§С‚Рѕ РёРјРµРЅРЅРѕ РЅСѓР¶РЅРѕ СЃРґРµР»Р°С‚СЊ"><%= @createDraft.description %></textarea>
        </div>

        <div class="form-group">
          <label>РљРѕРјРјРµРЅС‚Р°СЂРёР№ РґРёСЃРїРµС‚С‡РµСЂР°</label>
          <textarea class="form-control js-create-comment js-create-draft-field" rows="3" placeholder="Р’РЅСѓС‚СЂРµРЅРЅРёР№ РєРѕРјРјРµРЅС‚Р°СЂРёР№ РїРѕ Р·Р°СЏРІРєРµ"><%= @createDraft.comment %></textarea>
        </div>
        </div>

          <div class="form-group">
            <label>Р’Р»РѕР¶РµРЅРёСЏ РїСЂРё РѕС„РѕСЂРјР»РµРЅРёРё</label>
            <div class="dom-servis-dispatch-modal__attachment-toolbar">
              <select class="form-control js-create-attachment-kind">
                <% for kind in @createAttachmentKinds: %>
                  <option value="<%= kind.id %>"<%= ' selected' if "#{@createAttachmentKind}" is "#{kind.id}" %>><%= kind.label %></option>
                <% end %>
              </select>
              <input class="js-create-attachment-input" type="file" style="display:none" multiple>
              <button class="btn js-trigger-create-attachment-upload"<%= ' disabled' if @createAttachmentUploading %>>
                <%= 'Р—Р°РіСЂСѓР·РєР°вЂ¦' if @createAttachmentUploading %>
                <%= 'Р’С‹Р±СЂР°С‚СЊ С„Р°Р№Р»С‹' if !@createAttachmentUploading %>
              </button>
            </div>
            <div class="dom-servis-dispatch-modal__attachment-caption">РџСЂРёР»РѕР¶Рё РІС…РѕРґРЅС‹Рµ РјР°С‚РµСЂРёР°Р»С‹ СЃСЂР°Р·Сѓ РїСЂРё РѕС„РѕСЂРјР»РµРЅРёРё: СЃС…РµРјСѓ РґРѕСЃС‚СѓРїР°, С„РѕС‚Рѕ РёР»Рё РґРѕРєСѓРјРµРЅС‚С‹.</div>
            <% if @createAttachmentFiles.length > 0: %>
              <div class="dom-servis-dispatch-modal__attachment-draft">
                <% for file in @createAttachmentFiles: %>
                  <div class="dom-servis-dispatch-modal__attachment-draft-item">
                    <div class="dom-servis-dispatch-modal__attachment-draft-main">
                      <div class="dom-servis-dispatch-modal__attachment-draft-name"><%= file.name %></div>
                      <div class="dom-servis-dispatch-modal__attachment-draft-meta"><%= file.size %> B</div>
                    </div>
                    <button class="btn btn--danger js-remove-create-attachment" data-index="<%= file.index %>"<%= ' disabled' if @createAttachmentUploading %>>РЈР±СЂР°С‚СЊ</button>
                  </div>
                <% end %>
              </div>
            <% else: %>
              <div class="dom-servis-dispatch-modal__attachment-empty">Р’Р»РѕР¶РµРЅРёСЏ РїРѕРєР° РЅРµ РґРѕР±Р°РІР»РµРЅС‹.</div>
            <% end %>
          </div>
        <div class="dom-servis-dispatch-modal__footer">
          <div class="dom-servis-dispatch-modal__hint">Р•СЃР»Рё РґР°С‚Сѓ РЅРµ РјРµРЅСЏС‚СЊ, Р·Р°СЏРІРєР° Р±СѓРґРµС‚ РїРѕСЃС‚Р°РІР»РµРЅР° РІ РІС‹Р±СЂР°РЅРЅС‹Р№ РґРµРЅСЊ РѕС‚РєСЂС‹С‚РѕР№ РЅРµРґРµР»Рё.</div>
          <div class="dom-servis-dispatch-modal__footer-actions">
            <button class="btn js-close-create">РћС‚РјРµРЅР°</button>
            <button class="btn btn--success js-create-job">РћРїСѓР±Р»РёРєРѕРІР°С‚СЊ РІ РїСѓР»</button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

